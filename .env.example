# Copie este arquivo para ".env" e preencha o que for usar.
# Nunca coloque chaves reais neste arquivo de exemplo.

# --- Geração de texto ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternativa OpenAI, se necessário:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pesquisa de tendências ---
# Google News RSS funciona sem chave. NEWS_API_KEY e opcional.
NEWS_API_KEY=

# --- Identidade do canal ---
BRAND_HANDLE=@vambora.astro
BRAND_NAME=VAMBORA

# Ajuste opcional de tom/abordagem enviado a IA em toda execucao.
# Tambem pode ser sobrescrito pela opcao --instruction.
EXTRA_AI_INSTRUCTION=

# --- Log ---
LOG_LEVEL=INFO
